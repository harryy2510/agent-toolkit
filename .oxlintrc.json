{
	"$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxlint/head/npm/oxlint/configuration_schema.json",
	"rules": {
		"no-unused-vars": "warn",
		"no-console": "warn",
		"eqeqeq": "error",
		"no-var": "error",
		"prefer-const": "error",
		"no-debugger": "error",
		"no-alert": "error",
		"no-eval": "error",
		"no-implied-eval": "error"
	},
	"ignorePatterns": ["node_modules", "dist", ".wrangler", "*.gen.ts"]
}
